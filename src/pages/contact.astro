---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import T from "../components/T.astro";
import { ui } from "../lib/i18n";
import { isExternalHref, socialLinks } from "../lib/socials";

const socials = socialLinks();
const tints = ["hover:border-secondary/50", "hover:border-accent/50", "hover:border-coral/50", "hover:border-sky/50"];
---

<Layout title={ui.contact.en} description={ui.contactIntro}>
  <div class="page py-16 sm:py-24">
    <PageHeader kicker={ui.contactKicker} title={ui.contactTitle} intro={ui.contactIntro} />

    <div class="mt-12 grid gap-8 md:grid-cols-[1.3fr_1fr]">
      <div class="card p-6 sm:p-8">
        <ContactForm />
      </div>
      <aside>
        <p class="font-mono text-xs tracking-widest text-secondary uppercase">
          <T t={ui.elsewhere} />
        </p>
        <ul class="mt-5 space-y-3">
          {
            socials.map((item, index) => (
              <li>
                <a
                  href={item.href}
                  target={isExternalHref(item.href) ? "_blank" : undefined}
                  rel={isExternalHref(item.href) ? "noreferrer" : undefined}
                  class:list={[
                    "group flex min-h-11 items-center rounded-2xl border border-border/70 bg-card px-4 py-3 shadow-sm transition hover:-translate-y-0.5",
                    tints[index % tints.length],
                  ]}
                >
                  <span class="min-w-0">
                    <span class="block text-sm font-medium">{item.label}</span>
                    <span class="block truncate font-mono text-xs text-muted-foreground">{item.handle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</Layout>
