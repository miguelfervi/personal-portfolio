---
import Layout from "../../layouts/Layout.astro";
import { getProject, projects, site } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug ?? "");

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}
---

<Layout title={project.title} description={project.excerpt}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <a href="/#projects" class="text-sm text-white/55 hover:text-white">← Projects</a>
    <div
      class:list={["mt-6 overflow-hidden rounded-3xl border border-white/10", `tone-${project.tone}`]}
      transition:name={`card-${project.slug}`}
    >
      <div class="aspect-[16/8] p-6">
        <span class="rounded-full bg-black/30 px-3 py-1 text-xs font-medium text-white/90">
          {project.year}
        </span>
      </div>
    </div>
    <p class="mt-8 text-sm uppercase tracking-[0.2em] text-secondary">{site.brand}</p>
    <h1 class="mt-3 font-serif text-4xl text-white sm:text-5xl">{project.title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-white/70">{project.description}</p>
    <ul class="mt-8 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <li class="rounded-full bg-white/8 px-3 py-1.5 text-sm text-white/70">{tag}</li>
        ))
      }
    </ul>
  </article>
</Layout>
