---
import Layout from "../../layouts/Layout.astro";
import ProjectKind from "../../components/ProjectKind.astro";
import Prose from "../../components/Prose.astro";
import TagList from "../../components/TagList.astro";
import T from "../../components/T.astro";
import type { Project } from "../../lib/content";
import { listProjects } from "../../lib/content";
import { ui } from "../../lib/i18n";
import { toneFor } from "../../lib/tone";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const projects = await listProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const tone = toneFor(project.slug);
---

<Layout title={project.title.en} description={project.excerpt}>
  <article class="page-narrow py-16 sm:py-24">
    <a href={withBase("/projects")} class="inline-flex min-h-11 items-center text-sm text-muted-foreground hover:text-secondary">
      <T t={ui.backToProjects} />
    </a>
    {
      project.image && (
        <div class:list={["mt-8 overflow-hidden rounded-3xl shadow-[var(--shadow-card)]", `tone-${tone}`]}>
          <img src={withBase(project.image)} alt="" width="1200" height="675" class="aspect-[16/9] w-full object-cover" />
        </div>
      )
    }
    <header class={project.image ? "mt-10" : "mt-8"}>
      <ProjectKind project={project} />
      <p class="mt-3 font-mono text-xs text-muted-foreground">{project.year}</p>
      <h1 class="mt-3 font-serif text-[2.15rem] leading-[1.15] font-medium tracking-tight sm:text-5xl">
        <T t={project.title} />
      </h1>
    </header>
    <div class="mt-10">
      <Prose text={project.body} />
    </div>
    <div class="mt-12">
      <TagList tags={project.tags} />
    </div>
    <div class="mt-8 flex flex-wrap gap-5 text-sm">
      {
        project.demo && (
          <a href={project.demo} target="_blank" rel="noreferrer" class="text-accent hover:opacity-80">
            <T t={ui.demo} />
          </a>
        )
      }
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noreferrer" class="text-muted-foreground hover:text-foreground">
            <T t={ui.code} />
          </a>
        )
      }
    </div>
  </article>
</Layout>
