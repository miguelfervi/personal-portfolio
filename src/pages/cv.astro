---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import SkillChips from "../components/SkillChips.astro";
import T from "../components/T.astro";
import { listEducation, listExperience } from "../lib/content";
import { ui } from "../lib/i18n";
import { site, skills, spokenLanguages } from "../lib/site";

const experience = await listExperience();
const education = await listEducation();
---

<Layout title="CV" description={site.tagline}>
  <div class="page-narrow py-16 sm:py-24">
    <PageHeader kicker={ui.resume} title={site.name} intro={site.tagline} />
    <p class="mt-4 inline-flex rounded-full bg-card px-3 py-1.5 text-sm text-muted-foreground shadow-sm">
      <T t={site.role} /> · <T t={site.location} />
    </p>

    <section class="mt-14">
      <h2 class="mb-6 font-serif text-2xl font-medium">
        <T t={ui.experience} />
      </h2>
      <ol class="space-y-5">
        {
          experience.map((job) => (
            <li class="card p-5 sm:p-6">
              <div class="grid gap-1 sm:flex sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="font-serif text-xl font-medium">
                  <T t={job.role} /> · <span class="text-secondary"><T t={job.company} /></span>
                </h3>
                <p class="shrink-0 font-mono text-xs text-muted-foreground">
                  <T t={job.period} />
                </p>
              </div>
              <p class="mt-1 text-sm text-muted-foreground">
                <T t={job.location} />
              </p>
              <ul class="mt-4 space-y-3">
                {job.bullets.map((bullet) => (
                  <li class="max-w-measure font-serif text-base leading-relaxed text-muted-foreground">
                    <T t={bullet} />
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14">
      <h2 class="mb-6 font-serif text-2xl font-medium">
        <T t={ui.education} />
      </h2>
      <ul class="space-y-4">
        {
          education.map((item) => (
            <li class="card p-5">
              <div class="grid gap-1 sm:flex sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="font-serif text-xl font-medium">
                  <T t={item.degree} />
                </h3>
                <p class="shrink-0 font-mono text-xs text-muted-foreground">
                  <T t={item.period} />
                </p>
              </div>
              <p class="mt-1 text-sm text-coral">
                <T t={item.school} />
              </p>
              <p class="mt-2 max-w-measure text-base leading-relaxed text-muted-foreground">
                <T t={item.detail} />
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="mb-6 font-serif text-2xl font-medium">
        <T t={ui.technicalSkills} />
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          skills.map((group) => (
            <div class="card p-5">
              <p class="font-mono text-sm text-accent">
                <T t={group.group} />
              </p>
              <SkillChips items={group.items} />
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <h2 class="mb-6 font-serif text-2xl font-medium">
        <T t={ui.spokenLanguages} />
      </h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          spokenLanguages.map((lang) => (
            <li class="card flex items-baseline justify-between gap-4 px-5 py-4">
              <p class="font-serif text-base">
                <T t={lang.name} />
              </p>
              <p class="font-mono text-xs text-secondary">
                <T t={lang.level} />
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
