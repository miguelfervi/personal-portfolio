---
import Layout from "../layouts/Layout.astro";
import T from "../components/T.astro";
import { ui } from "../lib/i18n";
import { withBase } from "../lib/url";
---

<Layout title="404" description={ui.notFoundBody}>
  <div class="flex min-h-[60vh] items-center justify-center px-5">
    <div class="card max-w-md p-10 text-center">
      <p class="font-mono text-sm text-coral"><T t={ui.notFoundKicker} /></p>
      <h1 class="mt-4 font-serif text-4xl font-medium"><T t={ui.notFoundTitle} /></h1>
      <p class="mt-4 text-muted-foreground">
        <T t={ui.notFoundBody} />
      </p>
      <a href={withBase("/")} class="btn mt-8 bg-accent text-accent-foreground">
        <T t={ui.goHome} />
      </a>
    </div>
  </div>
</Layout>
