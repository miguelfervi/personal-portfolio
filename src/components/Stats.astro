---
import { stats } from "../data/site";
---

<section class="border-y border-white/8 bg-white/[0.03]">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    {
      stats.map((item) => (
        <div>
          <p class="font-serif text-4xl text-white">{item.value}</p>
          <p class="mt-2 text-sm text-white/55">{item.label}</p>
        </div>
      ))
    }
  </div>
</section>
