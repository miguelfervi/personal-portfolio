---
import { requestLocale, ui } from "../lib/i18n";
import { site } from "../lib/site";
import { pageHref, withBase } from "../lib/url";
import SocialLinks from "./SocialLinks.astro";
import T from "./T.astro";

const locale = requestLocale(Astro.currentLocale, Astro.url.pathname);
---

<section class="page pt-14 pb-10 sm:pt-20 sm:pb-14">
  <div class="grid items-center gap-10 md:grid-cols-[1.2fr_0.8fr]">
    <div class="animate-rise min-w-0">
      <p class="inline-flex max-w-full rounded-full bg-secondary/15 px-3 py-1 font-mono text-xs tracking-wide text-secondary uppercase sm:tracking-[0.16em]">
        <T t={site.role} />
      </p>
      <h1 class="mt-5 font-serif text-[2.5rem] leading-[1.08] font-medium tracking-tight text-balance sm:text-6xl">
        {site.name}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
        <T t={site.tagline} />
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={pageHref("/projects", locale, import.meta.env.BASE_URL)}
          class="btn bg-accent text-accent-foreground"
        >
          <T t={ui.viewProjects} />
        </a>
        <a
          href={`mailto:${site.email}`}
          class="btn border border-border bg-card hover:border-secondary/50"
        >
          <T t={ui.getInTouch} />
        </a>
      </div>
      <SocialLinks variant="labeled" include={["github", "linkedin"]} class="mt-5" />
    </div>

    <div class="animate-rise justify-self-start md:justify-self-end">
      <div class="relative">
        <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-coral/50 blur-2xl"></div>
        <div class="absolute -right-4 -bottom-8 h-28 w-28 rounded-full bg-secondary/40 blur-2xl"></div>
        <img
          src={withBase("/avatar.svg")}
          alt=""
          width="256"
          height="256"
          class="relative h-48 w-48 rounded-[2rem] border-4 border-card object-cover shadow-[var(--shadow-card)] sm:h-64 sm:w-64"
        />
      </div>
    </div>
  </div>
</section>
