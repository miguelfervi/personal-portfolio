---
import { featuredProject, site } from "../data/site";
---

<section class="mx-auto max-w-6xl px-4 pb-8 pt-10 sm:px-6 sm:pt-14">
  <p class="max-w-2xl text-sm leading-relaxed text-white/55">{site.greeting}</p>

  <div class="mt-8 grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-secondary">Personal portfolio</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight text-white sm:text-6xl">
        {site.headline}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white shadow-[0_8px_24px_rgba(47,87,239,0.35)] transition hover:brightness-110"
        >
          View projects
        </a>
        <a
          href="/about"
          class="rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white/90 transition hover:bg-white/5"
        >
          About
        </a>
      </div>
    </div>

    <a
      href={`/projects/${featuredProject.slug}`}
      class="group overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-2xl"
      transition:name={`card-${featuredProject.slug}`}
    >
      <div class:list={["relative aspect-[16/10] p-6", `tone-${featuredProject.tone}`]}>
        <span class="absolute left-5 top-5 rounded-full bg-black/30 px-3 py-1 text-xs font-medium text-white/90">
          Featured · {featuredProject.year}
        </span>
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-6">
          <h2 class="text-2xl font-semibold text-white">{featuredProject.title}</h2>
          <p class="mt-2 line-clamp-2 text-sm text-white/80">{featuredProject.excerpt}</p>
        </div>
      </div>
    </a>
  </div>
</section>
