---
import { paragraphs, requestLocale, type Text } from "../lib/i18n";

interface Props {
  text: Text;
}

const { text } = Astro.props;
const locale = requestLocale(Astro.currentLocale, Astro.url.pathname);
const body = paragraphs(text[locale]);
---

<div class="prose">
  {body.map((paragraph) => <p>{paragraph}</p>)}
</div>
