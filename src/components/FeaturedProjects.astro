---
import { featuredProjects } from "../lib/content";
import { ui } from "../lib/i18n";
import { withBase } from "../lib/url";
import ProjectCard from "./ProjectCard.astro";
import T from "./T.astro";

const featured = await featuredProjects();
---

<section class="page py-8 sm:py-12">
  <div class="flex items-end justify-between gap-4">
    <h2 class="font-serif text-3xl font-medium tracking-tight sm:text-4xl">
      <T t={ui.featured} />
    </h2>
    <a href={withBase("/projects")} class="rounded-full bg-card px-3 py-1.5 font-mono text-xs text-secondary shadow-sm hover:bg-accent-soft">
      <T t={ui.viewAll} />
    </a>
  </div>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((project) => <ProjectCard project={project} variant="featured" />)}
  </div>
</section>
