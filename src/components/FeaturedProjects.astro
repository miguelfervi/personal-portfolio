---
import { projects } from "../data/site";
import ProjectCard from "./ProjectCard.astro";

const list = projects.filter((project) => !project.featured);
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-secondary">Work</p>
      <h2 class="mt-2 font-serif text-3xl text-white sm:text-4xl">Featured projects</h2>
      <p class="mt-3 max-w-xl text-white/60">
        Highlighted, in progress, or ready to replace with the real cards from the board.
      </p>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {list.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
