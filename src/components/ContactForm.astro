---
import { contactFallbackAction } from "../lib/contact";
import { ui } from "../lib/i18n";
import Field from "./Field.astro";
import T from "./T.astro";
---

<form id="contact-form" class="grid gap-5" method="post" action={contactFallbackAction()}>
  <input type="hidden" name="_subject" value="Portfolio contact" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <div class="hidden" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <Field id="name" label={ui.name} placeholder={ui.namePlaceholder} autocomplete="name" />
  <Field id="email" label={ui.email} placeholder={ui.emailPlaceholder} type="email" autocomplete="email" />
  <Field id="message" label={ui.message} placeholder={ui.messagePlaceholder} rows={6} />
  <button type="submit" class="btn self-start bg-secondary text-secondary-foreground">
    <span data-submit-label><T t={ui.send} /></span>
  </button>
  <p id="form-status" class="text-sm text-muted-foreground" role="status">
    <T t={ui.formHint} />
  </p>
</form>

<script>
  import { contactEndpoint, contactPayload, isValidContact } from "../lib/contact";
  import { ui } from "../lib/i18n";

  const form = document.getElementById("contact-form");
  if (form instanceof HTMLFormElement) {
    const status = document.getElementById("form-status");
    const label = form.querySelector("[data-submit-label]");
    const button = form.querySelector("button[type='submit']");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(button instanceof HTMLButtonElement) || !label || !status) return;
      const lang = document.documentElement.lang === "es" ? "es" : "en";
      const data = new FormData(form);
      const fields = {
        name: String(data.get("name") ?? ""),
        email: String(data.get("email") ?? ""),
        message: String(data.get("message") ?? ""),
        honey: String(data.get("website") ?? ""),
      };

      if (!isValidContact(fields)) {
        status.textContent = ui.formError[lang];
        return;
      }

      button.disabled = true;
      label.textContent = ui.sending[lang];

      try {
        const response = await fetch(contactEndpoint(), {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(contactPayload(fields)),
        });
        if (!response.ok) throw new Error("send failed");
        form.reset();
        status.textContent = ui.formSuccess[lang];
      } catch {
        status.textContent = ui.formError[lang];
      } finally {
        button.disabled = false;
        label.textContent = ui.send[lang];
      }
    });
  }
</script>
