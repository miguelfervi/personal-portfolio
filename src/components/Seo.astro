---
import { requestLocale, type Text } from "../lib/i18n";
import { pageSeo } from "../lib/seo";

interface Props {
  title?: string;
  description?: string | Text;
}

const { title, description } = Astro.props;
const locale = requestLocale(Astro.currentLocale, Astro.url.pathname);
const seo = pageSeo({
  title,
  description,
  locale,
  pathname: Astro.url.pathname,
  origin: Astro.site ?? Astro.url,
  base: import.meta.env.BASE_URL,
  siteUrl: Astro.site,
});
---

<title>{seo.documentTitle}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
<link rel="alternate" hreflang="en" href={seo.enUrl} />
<link rel="alternate" hreflang="es" href={seo.esUrl} />
<link rel="alternate" hreflang="x-default" href={seo.enUrl} />
<meta property="og:site_name" content={seo.jsonLd.name} />
<meta property="og:title" content={seo.documentTitle} />
<meta property="og:description" content={seo.description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:locale" content={seo.ogLocale} />
<meta property="og:locale:alternate" content={seo.ogLocaleAlternate} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.documentTitle} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(seo.jsonLd)} />
