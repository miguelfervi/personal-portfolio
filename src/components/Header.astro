---
import { ui } from "../lib/i18n";
import { navItems, isActivePath } from "../lib/nav";
import { site } from "../lib/site";
import { stripBase, withBase } from "../lib/url";
import PrefControls from "./PrefControls.astro";
import SocialLinks from "./SocialLinks.astro";
import T from "./T.astro";

const pathname = stripBase(Astro.url.pathname, import.meta.env.BASE_URL);
---

<header class="sticky top-0 z-50 border-b border-white/40 bg-background/70 backdrop-blur-xl dark:border-white/10">
  <div class="page flex items-center gap-3 py-3.5 sm:gap-4">
    <a href={withBase("/")} class="min-w-0 truncate font-mono text-sm tracking-tight text-foreground">
      <span class="text-secondary">/</span> {site.handle}
    </a>

    <nav class="ml-auto hidden items-center gap-1 sm:flex" aria-label={ui.navAria.en}>
      {
        navItems.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              "relative px-3 py-1.5 text-sm transition-colors after:absolute after:inset-x-3 after:-bottom-0.5 after:h-px after:origin-left after:bg-secondary after:transition-transform after:duration-300 hover:text-foreground",
              isActivePath(pathname, item.href)
                ? "text-foreground after:scale-x-100"
                : "text-muted-foreground after:scale-x-0",
            ]}
          >
            <T t={item.label} />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 max-sm:ml-auto">
      <SocialLinks include={["github", "linkedin"]} />
      <PrefControls />
      <button
        type="button"
        id="menu-toggle"
        aria-label={ui.openMenu.en}
        data-aria-en={ui.openMenu.en}
        data-aria-es={ui.openMenu.es}
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn sm:hidden"
      >
        <svg data-menu-icon="open" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg data-menu-icon="close" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" hidden class="page border-t border-border/50 bg-background py-3 sm:hidden" aria-label={ui.mobileAria.en}>
    {
      navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "block min-h-11 py-2 text-sm",
            isActivePath(pathname, item.href) ? "text-foreground" : "text-muted-foreground",
          ]}
        >
          <T t={item.label} />
        </a>
      ))
    }
  </nav>
</header>
