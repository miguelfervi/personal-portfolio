---
import { site } from "../data/site";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/#projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-white/8 bg-ink/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="font-semibold tracking-tight text-white">
      {site.brand}<span class="text-secondary">.</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-white/70 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "transition hover:text-white",
              pathname === link.href && "text-white",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={`mailto:${site.email}`}
      class="hidden rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white shadow-[0_8px_24px_rgba(47,87,239,0.35)] transition hover:brightness-110 md:inline-flex"
    >
      Contact
    </a>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 text-white md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only">Open menu</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/8 px-4 py-4 md:hidden" hidden>
    <nav class="flex flex-col gap-3 text-sm" aria-label="Mobile">
      {
        links.map((link) => (
          <a href={link.href} class="rounded-lg px-2 py-2 text-white/80 hover:bg-white/5 hover:text-white">
            {link.label}
          </a>
        ))
      }
      <a href={`mailto:${site.email}`} class="rounded-lg bg-primary px-3 py-2 text-center font-semibold text-white">
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  function setupMenu() {
    const toggle = document.querySelector("[data-menu-toggle]");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";
    toggle.addEventListener("click", () => {
      const open = !menu.hasAttribute("hidden");
      menu.toggleAttribute("hidden", open);
      menu.classList.toggle("hidden", open);
      toggle.setAttribute("aria-expanded", String(!open));
    });
  }

  document.addEventListener("astro:page-load", setupMenu);
</script>
