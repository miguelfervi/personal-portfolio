---
import { requestLocale, ui } from "../lib/i18n";
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";

const locale = requestLocale(Astro.currentLocale, Astro.url.pathname);
---

<button type="button" data-theme-toggle aria-label={ui.darkMode[locale]} class="icon-btn hover:text-coral">
  <span class="inline-flex dark:hidden"><Moon /></span>
  <span class="hidden dark:inline-flex"><Sun /></span>
</button>
