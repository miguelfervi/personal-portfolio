---
import { requestLocale, ui } from "../lib/i18n";
import { navItems } from "../lib/nav";
import { site } from "../lib/site";
import { externalLinkAttrs, socialLinks } from "../lib/socials";
import { pageHref } from "../lib/url";
import T from "./T.astro";

const year = new Date().getFullYear();
const socials = socialLinks();
const locale = requestLocale(Astro.currentLocale, Astro.url.pathname);
---

<footer class="mt-10 border-t border-border/60 bg-card/50">
  <div class="page grid gap-8 py-12 sm:grid-cols-[1.4fr_1fr_1fr]">
    <div class="min-w-0">
      <p class="font-serif text-xl text-foreground">{site.name}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted-foreground">
        <T t={site.role} />.
      </p>
    </div>

    <nav aria-label={ui.navigation[locale]}>
      <p class="font-mono text-xs tracking-widest text-secondary uppercase">
        <T t={ui.navigation} />
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a href={pageHref(item.href, locale, import.meta.env.BASE_URL)} class="text-muted-foreground transition-colors hover:text-accent">
                <T t={item.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={ui.social[locale]}>
      <p class="font-mono text-xs tracking-widest text-coral uppercase">
        <T t={ui.social} />
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          socials.map((item) => (
            <li>
              <a
                href={item.href}
                {...externalLinkAttrs(item.href)}
                class="text-muted-foreground transition-colors hover:text-secondary"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <p class="page pb-8 text-xs text-muted-foreground">
    © {year} {site.name}. <T t={ui.footerCredit} />
  </p>
</footer>
