---
import type { Project } from "../lib/content";
import { ui } from "../lib/i18n";
import { toneFor } from "../lib/tone";
import { withBase } from "../lib/url";
import ProjectKind from "./ProjectKind.astro";
import T from "./T.astro";
import TagList from "./TagList.astro";

interface Props {
  project: Project;
  variant?: "featured" | "listing";
}

const { project, variant = "listing" } = Astro.props;
const href = withBase(`/projects/${project.slug}`);
const image = project.image ? withBase(project.image) : undefined;
const tone = toneFor(project.slug);
---

<article class="card group flex flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-xl">
  {
    image && (
      <a href={href} class="overflow-hidden">
        <div class:list={["relative", `tone-${tone}`]}>
          <img
            src={image}
            alt=""
            loading="lazy"
            width="1200"
            height="800"
            class="aspect-[3/2] w-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.04] group-hover:opacity-100"
          />
        </div>
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <ProjectKind project={project} />
    <p class="mt-2 font-mono text-xs text-muted-foreground">{project.year}</p>
    <h2 class:list={["mt-1 font-serif font-medium tracking-tight", variant === "featured" ? "text-xl" : "text-2xl"]}>
      <a href={href} class="transition-colors hover:text-secondary">
        <T t={project.title} />
      </a>
    </h2>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
      <T t={variant === "featured" ? project.excerpt : project.description} />
    </p>
    {
      variant === "listing" && (
        <div class="mt-4">
          <TagList tags={project.tags} />
        </div>
      )
    }
    <div class="mt-5 flex flex-wrap gap-4 text-sm">
      <a href={href} class="font-medium text-accent hover:opacity-80">
        <T t={ui.read} />
      </a>
      {
        project.demo && (
          <a href={project.demo} target="_blank" rel="noreferrer" class="text-muted-foreground hover:text-foreground">
            <T t={ui.demo} />
          </a>
        )
      }
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noreferrer" class="text-muted-foreground hover:text-foreground">
            <T t={ui.code} />
          </a>
        )
      }
    </div>
  </div>
</article>
