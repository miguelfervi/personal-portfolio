---
import { ui } from "../lib/i18n";
---

<button
  type="button"
  data-lang-toggle
  aria-label={ui.switchToSpanish.en}
  data-aria-en={ui.switchToSpanish.en}
  data-aria-es={ui.switchToEnglish.es}
  class="icon-btn w-auto min-w-11 px-2 font-mono text-xs tracking-wide sm:w-auto sm:min-w-9"
>
  <span class="i18n-en">ES</span>
  <span class="i18n-es">EN</span>
</button>
