---
import { requestLocale, ui } from "../lib/i18n";
import { localeNeutralPath, pageHref } from "../lib/url";

const locale = requestLocale(Astro.currentLocale, Astro.url.pathname);
const other = locale === "es" ? "en" : "es";
const path = localeNeutralPath(Astro.url.pathname, import.meta.env.BASE_URL);
const href = pageHref(path, other, import.meta.env.BASE_URL);
const label = other === "es" ? ui.switchToSpanish[locale] : ui.switchToEnglish[locale];
---

<a
  href={href}
  aria-label={label}
  data-astro-prefetch
  class="icon-btn w-auto min-w-11 px-2 font-mono text-xs tracking-wide sm:w-auto sm:min-w-9"
>
  {other.toUpperCase()}
</a>
