---
import { highlights, site, skills } from "../data/site";
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-secondary">About</p>
      <h2 class="mt-3 font-serif text-4xl text-white sm:text-5xl">{site.headline}</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/70">{site.about}</p>

      <ul class="mt-8 flex flex-wrap gap-2">
        {
          skills.map((skill) => (
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white/80">{skill}</li>
          ))
        }
      </ul>
    </div>

    <ul class="space-y-4">
      {
        highlights.map((item) => (
          <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <h3 class="font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
